{
  "name": "source-viewer",
  "version": "1.0.0",
  "description": "A read-only code viewer (like Zed/VSCode, viewing only)",
  "main": "out/main/index.js",
  "author": "okoyfoeciov <92897177+okoyfoeciov@users.noreply.github.com>",
  "license": "MIT",
  "desktopName": "com.sourceviewer.app",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:deb": "npm run build && electron-builder --linux deb --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "dbus-next": "^0.10.2",
    "highlight.js": "^10.7.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.sourceviewer.app",
    "productName": "Source Viewer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "syncDesktopName": true
    }
  }
}
